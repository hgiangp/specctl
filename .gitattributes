# A .docx is a ZIP. If git ever treats one as text and normalizes its line endings the
# archive is corrupt, and the corruption is invisible until something tries to open it.
# Marking them binary is explicit rather than relying on git's content heuristic.
*.docx binary
*.dotx binary
*.xlsx binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.emf  binary
*.wmf  binary

# Markdown and Python are text with LF endings everywhere (FMT-09).
*.md   text eol=lf
*.py   text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
